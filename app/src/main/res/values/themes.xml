<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- App Theme -->
    <style name="Theme.Meridian" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryVariant">@color/navy_dark</item>
        <item name="colorPrimaryDark">@color/navy_dark</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorAccent">@color/accent_blue</item>

        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/screen_bg</item>
    </style>

    <!-- Base Meridian style -->
    <style name="Meridian" />

    <!-- Base Button Style -->
    <style
        name="Meridian.Button"
        parent="Widget.MaterialComponents.Button">

        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>

    </style>

    <!-- Primary Button -->
    <style
        name="Meridian.Button.Primary"
        parent="Meridian.Button">

        <item name="backgroundTint">@color/navy_dark</item>
        <item name="cornerRadius">14dp</item>

        <item name="android:textColor">@color/white</item>

        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>

    </style>

    <!-- Outline Button -->
    <style
        name="Meridian.Button.Outline"
        parent="Widget.MaterialComponents.Button.OutlinedButton">

        <item name="strokeColor">@color/navy_dark</item>
        <item name="android:textColor">@color/navy_dark</item>

        <item name="cornerRadius">14dp</item>

        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>

        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>

    </style>

    <!-- Heading -->
    <style
        name="Meridian.Heading"
        parent="Meridian">

        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>

    </style>

    <!-- Body -->
    <style
        name="Meridian.Body"
        parent="Meridian">

        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>

    </style>

    <!-- Form Label -->
    <style
        name="Meridian.Label"
        parent="Meridian">

        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>

    </style>

</resources>